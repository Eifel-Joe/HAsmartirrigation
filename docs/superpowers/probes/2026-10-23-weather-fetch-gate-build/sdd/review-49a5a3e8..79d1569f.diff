+def _throttled(owner, gate, retry_after):
+    """A fetch point that fails with a 429 whose ``Retry-After`` is ``retry_after``."""
+
+    def fetch():
+        owner.calls += 1
+        gate.note_response(_resp({"Retry-After": retry_after}))
+        return None
+
+    return fetch
+
